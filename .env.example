# AWS Bedrock (2D image generation + vision)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_IMAGE_MODEL_ID=us.stability.stable-image-control-sketch-v1:0
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# 3D generation
MESHY_API_KEY=
STABILITY_API_KEY=
TRIPOSR_URL=
REPLICATE_API_TOKEN=

# Cohere (embeddings for asset search)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0

# Backboard
BACKBOARD_API_KEY=

# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Pingram (optional)
PINGRAM_RECIPIENT=
PINGRAM_BASE_URL=https://api.ca.pingram.io
PINGRAM_SMS_TYPE=sms_compose_preview

# Local
BACKEND_PORT=3001
GODOT_PROJECT_ROOT=example_game/godot-FirstPersonStarter-main
SPRITES_PATH=sprites
